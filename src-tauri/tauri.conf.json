{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.1",
  "identifier": "com.prokapa.jarvis-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://192.168.20.210:8000 http://127.0.0.1:8000 http://localhost:8000 https://github.com https://objects.githubusercontent.com; img-src 'self' data: blob:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Cliente nativo do JARVIS",
    "longDescription": "Jarvis Desktop conversa com a API do JARVIS na rede de casa ou VPN. Sem agente local.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0OTg5RkNDRTBERDU2NjkKUldScFZ0M2d6SitZNU03cVBWMVR1dVZxbEtMdnVYaWVsSzF4UGtwa3JEU0pYblA1TVpSVGxPdkQK",
      "endpoints": [
        "https://github.com/maiconcongesco/jarvis-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
